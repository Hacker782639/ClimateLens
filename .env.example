# Copy to .env.local and fill in your Supabase project details.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use publishable key (sb_publishable_...) or legacy anon key only.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Never put a service_role/secret key in any NEXT_PUBLIC variable.
